# Cognito Auth (public - exposed to browser)
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=


# Cognito Auth (server-side only - token exchange)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=

# Backend API (chatbot-rag)
# Point the STAGING frontend at the STAGING backend (8081). Port 8080 is
# the production backend, whose Cognito pool differs from staging's, so
# staging-pool tokens were rejected ("JWT signing key not found in JWKS").
MEO_API_URL=

# Claude formatter (server-side)
ANTHROPIC_API_KEY=
COGNITO_REGION=
